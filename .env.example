# ShopSphere Environment Configuration

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere_db
DB_USERNAME=shopsphere
DB_PASSWORD=shopsphere_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Use strong random strings in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Stripe Payment Gateway (Test Mode)
STRIPE_API_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Storage Configuration (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# AWS S3 (optional for prod)
AWS_REGION=us-east-1
AWS_S3_BUCKET=shopsphere-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
